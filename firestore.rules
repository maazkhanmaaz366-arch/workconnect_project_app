rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // Helper function: Check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user is the specific user ID
    function isUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ----- USERS COLLECTION -----
    match /users/{userId} {
      allow read: if isAuthenticated(); // Anyone logged in can view profiles
      allow write: if isUser(userId) || isAdmin(); // Only user or admin can edit
      
      // Subcollections under users (e.g., portfolio)
      match /portfolio/{imageId} {
        allow read: if isAuthenticated();
        allow write: if isUser(userId) || isAdmin();
      }
    }

    // ----- JOBS COLLECTION -----
    match /jobs/{jobId} {
      allow read: if isAuthenticated(); // Anyone logged in can browse jobs
      allow create: if isAuthenticated() && request.resource.data.employerId == request.auth.uid; // Must be the creator
      allow update, delete: if isAuthenticated() && resource.data.employerId == request.auth.uid || isAdmin();
      
      // Subcollection: Applications
      match /applications/{appId} {
        allow read: if isAuthenticated() && 
          (resource.data.workerId == request.auth.uid || 
           get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid ||
           isAdmin());
        allow create: if isAuthenticated() && request.resource.data.workerId == request.auth.uid;
        allow update: if isAuthenticated() && 
          (resource.data.workerId == request.auth.uid || 
           get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid ||
           isAdmin());
      }
    }

    // ----- CHAT / MESSAGES -----
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && 
        (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      }
    }
    
    match /chatRooms/{roomId} {
      allow read, write: if isAuthenticated(); // Broad access to match existing flutter logic, tighten later if needed
    }

    match /certificates/{certId} {
      allow read, write: if isAuthenticated(); // Broad access for certificates
    }

    // ----- PAYMENTS (Escrow) -----
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && 
        (resource.data.workerId == request.auth.uid || 
         resource.data.employerId == request.auth.uid || 
         isAdmin());
      allow write: if isAuthenticated(); // Broadened slightly as flutter app creates payments directly
    }

    // ----- TIME LOGS (Clock-In) -----
    match /time_logs/{logId} {
      allow read: if isAuthenticated() && 
        (resource.data.workerId == request.auth.uid || 
         resource.data.employerId == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated() && request.resource.data.workerId == request.auth.uid;
      allow update: if isAdmin(); // Admin can fix time logs if needed
    }

    // ----- DISPUTES -----
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && 
        (resource.data.workerId == request.auth.uid || 
         resource.data.employerId == request.auth.uid || 
         isAdmin() || 
         resource.data.raisedById == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin(); // Only admin resolves disputes
    }

    // ----- REVIEWS -----
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow delete: if isAdmin(); // Admin can remove abusive reviews
    }
    
    // Fallback for collections not explicitly matched
    match /{document=**} {
      allow read, write: if request.auth != null; // Ensure the app keeps functioning for any missed collections
    }
  }
}
